{
  "name": "lazycat-browser",
  "version": "0.1.0",
  "description": "LazyCat Browser — minimalist secure browser with built-in blocking",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-web": "mkdir -p dist && cp -r ui/* dist/",
    "dist": "npm run build-web",
    "package-win": "electron-builder --win nsis",
    "package-all": "electron-builder",
    "prepare-android": "npm run build-web && echo 'See README for Capacitor steps'"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.example.lazycat",
    "productName": "LazyCat Browser",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
    ,
    "linux": {
      "target": ["AppImage"]
    }
  }
}
